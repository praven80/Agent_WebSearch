# --- Secrets -----------------------------------------------------------------
# .env holds the Gateway URL and is written by infra/deploy.sh. Never commit it;
# .env.example documents the keys instead.
.env
.env.*
!.env.example

# AWS credentials must never live in the repo.
.aws/
*.pem
*_credentials
credentials

# --- Python ------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / front end --------------------------------------------------------
node_modules/
web/dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.vite/

# --- Build artifacts ---------------------------------------------------------
# Lambda package staging: regenerated by deploy/deploy-app.sh on every deploy.
build/
*.zip

# --- Editors / OS ------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# --- Logs --------------------------------------------------------------------
*.log
