# Copy to .env and fill in. ./infra/deploy.sh writes the first two for you.
# Exported environment variables always win over values in this file.
#
# There are no search API keys here by design: both search options go through the
# AWS-managed Web Search tool, which needs no credential of its own.

# --- The AgentCore Gateway that fronts Web Search -------------------------
# The GatewayUrl output from infra/deploy.sh. Needed for Option 2.
AGENTCORE_GATEWAY_URL=

# Web Search is available in us-east-1, eu-west-1 and ap-northeast-1.
AWS_REGION=us-east-1

# Optional: named profile to use. Omit for the default credential chain.
# AWS_PROFILE=my-demo-profile

# --- Model used identically by both options -------------------------------
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# --- Search request parameters -------------------------------------------
# Results per search, 1-25. Enforced on every call, overriding the model.
MAX_SEARCH_RESULTS=5

# Request-level filters, applied to every search (connector 1.2.0+).
# Comma- or newline-separated; full URLs are reduced to the bare domain.
# A root domain also matches its subdomains. Up to 100 entries per list.
# SEARCH_DOMAIN_INCLUDE=python.org,docs.aws.amazon.com
# SEARCH_DOMAIN_EXCLUDE=reddit.com,quora.com

# Inclusive publication-date bounds, ISO YYYY-MM-DD. Web results only.
# SEARCH_PUBLISHED_FROM=2026-01-01
# SEARCH_PUBLISHED_TO=2026-09-15
